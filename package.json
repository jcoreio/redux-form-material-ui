{
  "name": "@jcoreio/redux-form-material-ui",
  "version": "0.0.0-development",
  "description": "An adapter between Redux Form and Material UI components",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcoreio/redux-form-material-ui"
  },
  "scripts": {
    "build:es": "cross-env BABEL_ENV=es babel src --out-dir es",
    "build:lib": "babel src --out-dir lib",
    "build:umd": "cross-env NODE_ENV=development webpack src/index.js dist/redux-form-material-ui.js",
    "build:umd:min": "cross-env NODE_ENV=production webpack src/index.js dist/redux-form-material-ui.min.js",
    "prepublish": "npm run test && npm run lint && npm run clean && npm run build",
    "test:cov": "cross-env NODE_ENV=test nyc --reporter=lcov --reporter=text npm test",
    "test:codecov": "cat ./coverage/lcov.info | ./node_modules/codecov.io/bin/codecov.io.js",
    "tc": "toolchain",
    "toolchain": "toolchain",
    "test": "toolchain test",
    "prepublishOnly": "echo This package is meant to be published by semantic-release from the dist build directory. && exit 1"
  },
  "keywords": [
    "redux",
    "redux-form",
    "material-ui",
    "redux-form-material-ui",
    "adapter"
  ],
  "author": "Erik Rasmussen <rasmussenerik@gmail.com> (http://github.com/erikras)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jcoreio/redux-form-material-ui/issues"
  },
  "homepage": "https://github.com/jcoreio/redux-form-material-ui",
  "devDependencies": {
    "@jcoreio/toolchain": "^5.5.3",
    "@jcoreio/toolchain-circle": "^5.5.3",
    "@jcoreio/toolchain-esnext": "^5.5.3",
    "@jcoreio/toolchain-mocha": "^5.5.3",
    "@jcoreio/toolchain-react": "^5.5.3",
    "@jcoreio/toolchain-semantic-release": "^5.5.3",
    "@jcoreio/toolchain-typescript": "^5.5.3",
    "@material-ui/core": "^4.12.4",
    "@types/chai": "^4.3.5",
    "@types/chai-subset": "^1.3.5",
    "@types/mocha": "^10.0.6",
    "@types/react": "^18.2.64",
    "@types/react-is": "^18.2.4",
    "@types/react-test-renderer": "^18.0.7",
    "@types/redux-form": "^8.3.10",
    "babel-loader": "^7.1.1",
    "chai": "^4.3.7",
    "chai-subset": "^1.6.0",
    "eslint": "^9.17.0",
    "global-jsdom": "^9.0.1",
    "globals": "^16.0.0",
    "jsdom": "^22.1.0",
    "lint-staged": "^15.2.2",
    "mocha": "^10.2.0",
    "nyc": "^17.1.0",
    "prettier": "^3.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-test-renderer": "^18.2.0",
    "typescript": "^5.4.2"
  },
  "peerDependencies": {
    "@material-ui/core": "^4.0.0 || ^5.0.0",
    "react": "16 || ^17.0.0 || ^18.0.0",
    "redux-form": "^7.0.0 || ^8.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "default": "./dist/index.d.ts"
      },
      "import": "./dist/index.mjs",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": {
        "import": "./dist/*.d.mts",
        "default": "./dist/*.d.ts"
      },
      "import": "./dist/*.mjs",
      "default": "./dist/*.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=16"
  },
  "packageManager": "pnpm@10.6.5",
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "react-is": "^18.2.0"
  },
  "@jcoreio/toolchain": {
    "migratedVersion": "5.5.3"
  }
}
